<Project Sdk="Microsoft.NET.Sdk">

  <!-- The one executable: `rtfx mcp` is the MCP server Claude Code starts. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Rtfx</RootNamespace>
    <AssemblyName>rtfx</AssemblyName>

    <!-- One version for the server and the runner (runner/lib.ps1). build/version.ps1 fails when they differ. -->
    <Version>0.3.1</Version>
    <Product>rtfx</Product>
    <Description>Hands coding jobs from Claude Code to GitHub Copilot CLI on another machine.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rtfx.Tests" />
  </ItemGroup>

</Project>
